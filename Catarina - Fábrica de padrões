public class FabricaDePadroes {

    public static void main(String[] args) {
        int n = 5;
        
        System.out.println("=== TRIÂNGULO ===");
        // TODO 1: Imprima um triângulo assim (n=5):
        //     *
        //    **
        //   ***
        //  ****
        // *****
        for (int i = 1; i <= n; i++) {
            for (int j = 0; j < n - i; j++) {
                System.out.print(" ");
            }
            for (int j = 0; j < i; j++) {
                System.out.print("*");
            }
            System.out.println();
        }
        
        System.out.println("\n=== TRIÂNGULO INVERTIDO ===");
        // TODO 2: Imprima um triângulo invertido:
        // *****
        //  ****
        //   ***
        //    **
        //     *
        for (int i = n; i >= 1; i--) {
            for (int j = 0; j < n - i; j++) {
                System.out.print(" ");
            }
            for (int j = 0; j < i; j++) {
                System.out.print("*");
            }
            System.out.println();
        }
        
        System.out.println("\n=== LOSANGO ===");
        // TODO 3: Combine ambos para formar um losango:
        //     *
        //    ***
        //   *****
        //  *******
        // *********
        //  *******
        //   *****
        //    ***
        //     *
        // Upper half (triangle)
        for (int i = 1; i <= n; i++) {
            for (int j = 0; j < n - i; j++) {
                System.out.print(" ");
            }
            for (int j = 0; j < 2 * i - 1; j++) {
                System.out.print("*");
            }
            System.out.println();
        }
        // Lower half (inverted triangle)
        for (int i = n - 1; i >= 1; i--) {
            for (int j = 0; j < n - i; j++) {
                System.out.print(" ");
            }
            for (int j = 0; j < 2 * i - 1; j++) {
                System.out.print("*");
            }
            System.out.println();
        }
    }
}
