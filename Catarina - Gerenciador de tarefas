import java.util.ArrayList;
import java.util.List;
import java.util.stream.Collectors;

// TODO 1: Crie o enum Status com: PENDENTE, EM_ANDAMENTO, CONCLUIDA
enum Status {
    PENDENTE, EM_ANDAMENTO, CONCLUIDA
}

class Tarefa {
    // TODO 2: Declare os atributos: int id, String titulo, Status status
    //         Crie construtor, getters, setters e toString()
    private int id;
    private String titulo;
    private Status status;

    public Tarefa(int id, String titulo, Status status) {
        this.id = id;
        this.titulo = titulo;
        this.status = status;
    }

    public int getId() {
        return id;
    }

    public void setId(int id) {
        this.id = id;
    }

    public String getTitulo() {
        return titulo;
    }

    public void setTitulo(String titulo) {
        this.titulo = titulo;
    }

    public Status getStatus() {
        return status;
    }

    public void setStatus(Status status) {
        this.status = status;
    }

    @Override
    public String toString() {
        return "[" + id + "] " + titulo + " - " + status;
    }
}

public class GerenciadorTarefas {
    private List<Tarefa> tarefas = new ArrayList<>();
    private int proximoId = 1;

    public void adicionar(String titulo) {
        // TODO 3: Crie uma nova Tarefa com id auto-incrementado e status PENDENTE
        //         Adicione à lista e imprima confirmação
        Tarefa novaTarefa = new Tarefa(proximoId, titulo, Status.PENDENTE);
        tarefas.add(novaTarefa);
        System.out.println("✓ Tarefa adicionada: " + novaTarefa);
        proximoId++;
    }

    public void listar() {
        if (tarefas.isEmpty()) {
            System.out.println("Nenhuma tarefa cadastrada.");
            return;
        }
        tarefas.forEach(System.out::println);
    }

    public void filtrarPorStatus(Status status) {
        // TODO 4: Use streams para filtrar tarefas pelo status informado
        //         Imprima as tarefas filtradas ou "Nenhuma tarefa encontrada."
        List<Tarefa> filtradas = tarefas.stream()
                .filter(t -> t.getStatus() == status)
                .collect(Collectors.toList());
        
        if (filtradas.isEmpty()) {
            System.out.println("Nenhuma tarefa encontrada.");
        } else {
            filtradas.forEach(System.out::println);
        }
    }

    public void atualizarStatus(int id, Status novoStatus) {
        // TODO 5: Encontre a tarefa pelo id e atualize o status
        //         Se não encontrar, lance IllegalArgumentException
        Tarefa tarefa = tarefas.stream()
                .filter(t -> t.getId() == id)
                .findFirst()
                .orElseThrow(() -> new IllegalArgumentException("Tarefa com id " + id + " não encontrada!"));
        
        tarefa.setStatus(novoStatus);
        System.out.println("✓ Status atualizado: Tarefa " + id + " agora está " + novoStatus);
    }

    public static void main(String[] args) {
        GerenciadorTarefas gm = new GerenciadorTarefas();
        gm.adicionar("Estudar Java");
        gm.adicionar("Fazer exercícios");
        gm.adicionar("Revisar código");
        
        gm.atualizarStatus(1, Status.CONCLUIDA);
        gm.atualizarStatus(2, Status.EM_ANDAMENTO);
        
        System.out.println("\n--- Todas as tarefas ---");
        gm.listar();
        
        System.out.println("\n--- Tarefas pendentes ---");
        gm.filtrarPorStatus(Status.PENDENTE);
    }
}
