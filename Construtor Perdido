public class Personagem {
    // TODO 1: Declare os atributos privados: nome (String), vida (int), ataque (int)
    private String nome;
    private int vida;
    private int ataque;

    // TODO 2: Crie um construtor que receba nome, vida e ataque
    //         vida deve ser no mínimo 1 e ataque no mínimo 0
    public Personagem(String nome, int vida, int ataque) {
        this.nome = nome;
        this.vida = vida < 1 ? 1 : vida;
        this.ataque = ataque < 0 ? 0 : ataque;
    }

    // TODO 3: Crie getters para todos os atributos
    //         Crie setter para 'vida' que não permita valores negativos
    public String getNome() {
        return nome;
    }

    public int getVida() {
        return vida;
    }

    public int getAtaque() {
        return ataque;
    }

    public void setVida(int vida) {
        this.vida = vida < 0 ? 0 : vida;
    }

    // TODO 4: Sobrescreva toString() para retornar:
    //         "[Guerreiro] Vida: 100 | Ataque: 25"
    @Override
    public String toString() {
        return "[" + nome + "] Vida: " + vida + " | Ataque: " + ataque;
    }

    public static void main(String[] args) {
        Personagem p = new Personagem("Guerreiro", 100, 25);
        System.out.println(p); // Deve imprimir: [Guerreiro] Vida: 100 | Ataque: 25
        
        p.setVida(-10);
        System.out.println("Vida após set negativo: " + p.getVida()); // Deve ser 0
        
        p.setVida(50);
        System.out.println("Vida após set válido: " + p.getVida()); // Deve ser 50
    }
}
